NODE_ENV=development
PORT=3000

# Em produção é obrigatório e deve conter apenas a origem, sem caminho.
# Exemplo fictício: https://www.exemplo.com.br
APP_ORIGIN=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nm_calcados_dev
DB_USER=nm_calcados_app
DB_PASSWORD=troque-esta-senha
DB_CONNECTION_LIMIT=10

SESSION_SECRET=gere-um-segredo-forte-com-pelo-menos-32-caracteres
SESSION_MAX_AGE_MINUTES=480
BCRYPT_ROUNDS=12

# Use somente no bootstrap do primeiro administrador e remova a senha após executar.
ADMIN_NAME=Administrador NM
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Hostinger Managed Node.js: não fixe PORT manualmente se o painel injetar a porta da aplicação.
# Em produção, configure NODE_ENV=production e APP_ORIGIN=https://seu-dominio.example no hPanel.
