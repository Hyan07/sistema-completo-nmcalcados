NODE_ENV=production
APP_ORIGIN=https://seu-dominio.example

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_forte_do_banco
DB_CONNECTION_LIMIT=10

SESSION_SECRET=gere_um_segredo_aleatorio_com_mais_de_32_caracteres
SESSION_MAX_AGE_MINUTES=480
BCRYPT_ROUNDS=12

# Defina ADMIN_* apenas temporariamente durante o bootstrap inicial.
# Remova ADMIN_PASSWORD do ambiente assim que o primeiro administrador for criado.
